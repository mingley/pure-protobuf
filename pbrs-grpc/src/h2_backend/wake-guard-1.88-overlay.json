          "start_line_index": 253,
          "end_line_index": 258,
          "old": "struct WakeGuard;\n#[allow(\n    clippy::manual_noop_waker,\n    reason = \"unique Arc ownership measures canceled task retention; a static noop waker cannot provide that oracle\"\n)]\n",
          "new": "// Unique task ownership measures cancellation retention; the counter also\n// makes Wake observable without relying on a static noop waker.\nstruct WakeGuard(Arc<AtomicUsize>);\n"
        },
        {
          "start_line_index": 259,
          "end_line_index": 260,
          "old": "    fn wake(self: Arc<Self>) {}\n",
          "new": "    fn wake(self: Arc<Self>) {\n        self.0.fetch_add(1, Ordering::SeqCst);\n    }\n"
        },
        {
          "start_line_index": 265,
          "end_line_index": 266,
          "old": "    let waker = Arc::new(WakeGuard);\n",
          "new": "    let wakes = Arc::new(AtomicUsize::new(0));\n    let waker = Arc::new(WakeGuard(wakes.clone()));\n"
        },
        {
          "start_line_index": 268,
          "end_line_index": 268,
          "old": "",
          "new": "    waker.wake_by_ref();\n    assert_eq!(wakes.load(Ordering::SeqCst), 1);\n"
        },
        {
          "start_line_index": 280,
          "end_line_index": 280,
          "old": "",
          "new": "    assert_eq!(wakes.load(Ordering::SeqCst), 1);\n"
        }
      ]
