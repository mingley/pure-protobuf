+// Bound the initial allocation for messages with large inline layouts. The
+// receive limit stays at BURST and the Vec grows normally when a producer
+// supplies a larger burst. A single item can exceed the byte target.
+fn initial_batch_item_capacity<T>() -> usize {
+    const INITIAL_ITEM_BYTES: usize = 16 * 1024;
+    let item_size = std::mem::size_of::<Result<crate::stream::Framed<T>, Status>>().max(1);
+    let items = (INITIAL_ITEM_BYTES / item_size).clamp(1, OutBatch::BURST);
+    // Align ordinary geometric growth with the power-of-two burst limit.
+    1usize << items.ilog2()
+}
