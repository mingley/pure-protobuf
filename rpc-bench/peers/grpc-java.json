{
  "$schema": "./peer.schema.json",
  "id": "grpc-java",
  "name": "grpc-java (Netty)",
  "description": "Official Java reference gRPC implementation on the Netty transport (io.grpc:grpc-netty)",
  "role": ["server"],
  "optional": true,
  "language": "java",
  "runtime": "JVM + Netty",
  "codec": "protobuf-java",
  "upstream_pin": {
    "repository": "grpc/grpc-java",
    "artifact": "io.grpc:grpc-netty",
    "version": "1.84.0",
    "resolved": "2026-09-29",
    "notes": "Maven Central latest stable at pin time; harness pins the exact version, never a range"
  },
  "server": {
    "description": "SB-18 grpc-java interop server (tests/interop/grpc-java; followup, not yet in tree)",
    "binary_name": "grpc-java-interop-server.jar",
    "candidates": [
      "tests/interop/grpc-java/target/grpc-java-interop-server.jar"
    ],
    "build_command": "cd tests/interop/grpc-java && ./mvnw -q package -Dgrpc.version=1.84.0",
    "args_template": [
      "java",
      "-jar",
      "{binary}",
      "--port={port}"
    ],
    "transport_contract": {
      "tcp_nodelay": true,
      "stream_window": 16777216,
      "conn_window": 16777216,
      "frame_size": 1048576,
      "max_streams": 256,
      "adaptive_window": false,
      "header_list": 16384,
      "mechanism": "NettyServerBuilder.flowControlWindow(16MiB).maxConcurrentCallsPerConnection(256) with ChannelOption.TCP_NODELAY; see bench/stack-matrix/peers/__init__.py"
    },
    "readiness": {
      "type": "socket_connect"
    }
  },
  "client": {
    "supported": false,
    "reason": "No open-loop client driver for grpc-java; optional client cells are not_run. Server cells use the native generator."
  },
  "matching_configuration": {
    "tcp_nodelay": true,
    "stream_window": 16777216,
    "conn_window": 16777216,
    "frame_size": 1048576,
    "max_streams": 256,
    "adaptive_window": false,
    "header_list": 16384,
    "tls_cipher": "TLS_AES_128_GCM_SHA256",
    "connections": 1,
    "concurrency": 1,
    "payload_sizes": {
      "empty_unary": { "request_bytes": 0, "response_bytes": 0 },
      "large_unary": { "request_bytes": 271828, "response_bytes": 314159 },
      "stream": { "message_bytes": 1024 },
      "ping_pong": { "message_bytes": 0, "round_trips": 256 },
      "upload": { "message_bytes": 1024 }
    }
  },
  "tls": {
    "supported": true,
    "plan": "Harness serves the in-tree PEM test PKI (--tls-cert/--tls-key) via Netty SslContextBuilder and restricts suites to TLS_AES_128_GCM_SHA256; the native generator verifies with ca.crt and server name localhost.",
    "server_args_template": ["--tls-cert={tls_cert}", "--tls-key={tls_key}"],
    "default_server_name": "localhost"
  }
}
