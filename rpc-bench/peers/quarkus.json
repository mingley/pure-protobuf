{
  "$schema": "./peer.schema.json",
  "id": "quarkus",
  "name": "Quarkus gRPC (grpc_bench row)",
  "description": "Quarkus gRPC server as run by grpc_bench (java_quarkus_bench)",
  "role": ["server"],
  "optional": true,
  "language": "java",
  "runtime": "JVM + Quarkus + vert.x HTTP/2",
  "codec": "protobuf-java",
  "upstream_pin": {
    "repository": "quarkusio/quarkus",
    "artifact": "io.quarkus:quarkus-grpc",
    "version": "3.1.2.Final",
    "reference": "grpc_bench@48b6b958832c995eee021361bdf3544d7c356fcc/java_quarkus_bench (2026-06-22)",
    "notes": "grpc_bench-era quarkus-bom pin; harness validates JVM/Maven skew at build time"
  },
  "server": {
    "description": "SB-18 Quarkus interop server (tests/interop/quarkus; followup, not yet in tree)",
    "binary_name": "quarkus-run.jar",
    "candidates": [
      "tests/interop/quarkus/target/quarkus-app/quarkus-run.jar"
    ],
    "build_command": "cd tests/interop/quarkus && ./mvnw -q package -Dquarkus.platform.version=3.1.2.Final",
    "args_template": [
      "java",
      "-jar",
      "{binary}",
      "--port={port}"
    ],
    "transport_contract": {
      "tcp_nodelay": true,
      "stream_window": 16777216,
      "conn_window": 16777216,
      "frame_size": 1048576,
      "max_streams": 256,
      "adaptive_window": false,
      "header_list": 16384,
      "mechanism": "quarkus-grpc over vert.x HTTP/2: 16 MiB windows, 256 max streams, TCP_NODELAY on"
    },
    "readiness": {
      "type": "socket_connect"
    }
  },
  "client": {
    "supported": false,
    "reason": "No open-loop client driver for Quarkus; optional client cells are not_run. Server cells use the native generator."
  },
  "matching_configuration": {
    "tcp_nodelay": true,
    "stream_window": 16777216,
    "conn_window": 16777216,
    "frame_size": 1048576,
    "max_streams": 256,
    "adaptive_window": false,
    "header_list": 16384,
    "tls_cipher": "TLS_AES_128_GCM_SHA256",
    "connections": 1,
    "concurrency": 1,
    "payload_sizes": {
      "empty_unary": { "request_bytes": 0, "response_bytes": 0 },
      "large_unary": { "request_bytes": 271828, "response_bytes": 314159 },
      "stream": { "message_bytes": 1024 },
      "ping_pong": { "message_bytes": 0, "round_trips": 256 },
      "upload": { "message_bytes": 1024 }
    }
  },
  "tls": {
    "supported": true,
    "plan": "Harness serves the in-tree PEM test PKI (--tls-cert/--tls-key) via Quarkus TLS registry and restricts suites to TLS_AES_128_GCM_SHA256; the native generator verifies with ca.crt and server name localhost.",
    "server_args_template": ["--tls-cert={tls_cert}", "--tls-key={tls_key}"],
    "default_server_name": "localhost"
  }
}
