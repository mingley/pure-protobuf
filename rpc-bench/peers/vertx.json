{
  "$schema": "./peer.schema.json",
  "id": "vertx",
  "name": "Vert.x gRPC (grpc_bench row)",
  "description": "Eclipse Vert.x gRPC server as run by grpc_bench (java_vertx_grpc_bench)",
  "role": ["server"],
  "optional": true,
  "language": "java",
  "runtime": "JVM + vert.x + Netty",
  "codec": "protobuf-java",
  "upstream_pin": {
    "repository": "eclipse-vertx/vertx-grpc",
    "artifact": "io.vertx:vertx-grpc-server",
    "version": "4.4.4",
    "grpc_version": "1.58.0",
    "reference": "grpc_bench@48b6b958832c995eee021361bdf3544d7c356fcc/java_vertx_grpc_bench (2026-06-22)",
    "notes": "grpc_bench-era pins; harness validates JVM/build-tool skew at build time"
  },
  "server": {
    "description": "SB-18 Vert.x interop server (tests/interop/vertx; followup, not yet in tree)",
    "binary_name": "vertx-interop",
    "candidates": [
      "tests/interop/vertx/build/install/vertx-interop/bin/vertx-interop"
    ],
    "build_command": "cd tests/interop/vertx && ./gradlew -q installDist",
    "args_template": [
      "{binary}",
      "--port={port}"
    ],
    "transport_contract": {
      "tcp_nodelay": true,
      "stream_window": 16777216,
      "conn_window": 16777216,
      "frame_size": 1048576,
      "max_streams": 256,
      "adaptive_window": false,
      "header_list": 16384,
      "mechanism": "vert.x HttpServerOptions: initialWindowSize 16 MiB, maxConcurrentStreams 256, TCP_NODELAY on"
    },
    "readiness": {
      "type": "socket_connect"
    }
  },
  "client": {
    "supported": false,
    "reason": "No open-loop client driver for Vert.x; optional client cells are not_run. Server cells use the native generator."
  },
  "matching_configuration": {
    "tcp_nodelay": true,
    "stream_window": 16777216,
    "conn_window": 16777216,
    "frame_size": 1048576,
    "max_streams": 256,
    "adaptive_window": false,
    "header_list": 16384,
    "tls_cipher": "TLS_AES_128_GCM_SHA256",
    "connections": 1,
    "concurrency": 1,
    "payload_sizes": {
      "empty_unary": { "request_bytes": 0, "response_bytes": 0 },
      "large_unary": { "request_bytes": 271828, "response_bytes": 314159 },
      "stream": { "message_bytes": 1024 },
      "ping_pong": { "message_bytes": 0, "round_trips": 256 },
      "upload": { "message_bytes": 1024 }
    }
  },
  "tls": {
    "supported": true,
    "plan": "Harness serves the in-tree PEM test PKI (--tls-cert/--tls-key) via vert.x PemKeyCertOptions and restricts suites to TLS_AES_128_GCM_SHA256; the native generator verifies with ca.crt and server name localhost.",
    "server_args_template": ["--tls-cert={tls_cert}", "--tls-key={tls_key}"],
    "default_server_name": "localhost"
  }
}
