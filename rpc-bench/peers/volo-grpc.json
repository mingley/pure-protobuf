{
  "$schema": "./peer.schema.json",
  "id": "volo-grpc",
  "name": "volo-grpc",
  "description": "CloudWeGo Volo gRPC framework for Rust",
  "role": ["server"],
  "optional": true,
  "language": "rust",
  "runtime": "tokio + volo-grpc",
  "codec": "prost",
  "upstream_pin": {
    "repository": "cloudwego/volo",
    "artifact": "volo-grpc",
    "version": "0.12.2",
    "resolved": "2026-09-29",
    "notes": "crates.io max stable at pin time; harness builds with --locked"
  },
  "server": {
    "description": "SB-18 volo-grpc interop server (tests/interop/volo; followup, not yet in tree)",
    "binary_name": "volo-interop-server",
    "candidates": [
      "target/release/volo-interop-server"
    ],
    "build_command": "cargo build --locked --release --manifest-path tests/interop/volo/Cargo.toml --target-dir target",
    "args_template": [
      "{binary}",
      "server",
      "--port={port}"
    ],
    "transport_contract": {
      "tcp_nodelay": true,
      "stream_window": 16777216,
      "conn_window": 16777216,
      "frame_size": 1048576,
      "max_streams": 256,
      "adaptive_window": false,
      "header_list": 16384,
      "mechanism": "volo-grpc server builder: 16 MiB stream/connection windows, 1 MiB frames, 256 streams, TCP_NODELAY on; getsockopt-verified like NodelayIncoming"
    },
    "readiness": {
      "type": "socket_connect"
    }
  },
  "client": {
    "supported": false,
    "reason": "No open-loop client driver for volo-grpc; optional client cells are not_run. Server cells use the native generator."
  },
  "matching_configuration": {
    "tcp_nodelay": true,
    "stream_window": 16777216,
    "conn_window": 16777216,
    "frame_size": 1048576,
    "max_streams": 256,
    "adaptive_window": false,
    "header_list": 16384,
    "tls_cipher": "TLS_AES_128_GCM_SHA256",
    "connections": 1,
    "concurrency": 1,
    "payload_sizes": {
      "empty_unary": { "request_bytes": 0, "response_bytes": 0 },
      "large_unary": { "request_bytes": 271828, "response_bytes": 314159 },
      "stream": { "message_bytes": 1024 },
      "ping_pong": { "message_bytes": 0, "round_trips": 256 },
      "upload": { "message_bytes": 1024 }
    }
  },
  "tls": {
    "supported": true,
    "plan": "Harness serves the in-tree PEM test PKI (--tls-cert/--tls-key) with the suite restricted to TLS_AES_128_GCM_SHA256; the native generator verifies with ca.crt and server name localhost.",
    "server_args_template": ["--tls-cert={tls_cert}", "--tls-key={tls_key}"],
    "default_server_name": "localhost"
  }
}
