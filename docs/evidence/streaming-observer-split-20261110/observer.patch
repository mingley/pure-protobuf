+    /// Finish a call logger after its last observable response or drop.
+    pub(crate) fn finish_observing_cancel(&self) {
+        let inner = self.inner();
+        if !inner.log_capable {
+            return;
+        }
+        let (emit, release) = {
+            let mut additional = inner.additional.lock().unwrap_or_else(|p| p.into_inner());
