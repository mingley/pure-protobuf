+            if let Some(log) = additional
+                .logging
+                .as_mut()
+                .and_then(|state| state.cancel_log.as_mut())
+            {
+                log.finished = true;
+                if cancelled && !log.emitted {
+                    log.pending = true;
+                }
+            }
+            let (emit, release) = claim_cancel(inner, &mut additional);
+            if release.is_some() {
+                (emit, release)
+            } else if let Some(log) = additional
+                .logging
+                .as_mut()
+                .and_then(|state| state.cancel_log.as_mut())
+            {
+                if !log.pending {
+                    (emit, log.logger.take())
+                } else {
+                    (emit, None)
+                }
+            } else {
+                (emit, None)
+            }
+        };
+        emit_cancel(emit);
+        drop(release);
+    }
