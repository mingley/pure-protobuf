+// Scratch-only split guard types used to compare logged and unlogged futures.
+struct UnloggedStreamingGuard;
+
+fn observe_stream_log(
+    cancel: &crate::rpc_cancel::RpcCancel,
+    tap: Option<&CallLogger>,
+) -> Option<crate::rpc_cancel::UnaryCancelLog> {
+    tap.map(|logger| cancel.observe_unary_cancel(logger))
+}
+
+fn observe_unlogged_stream(
+    _: &crate::rpc_cancel::RpcCancel,
+    _: Option<&CallLogger>,
+) -> UnloggedStreamingGuard {
+    UnloggedStreamingGuard
+}
+
+fn handoff_stream_log(guard: &mut Option<crate::rpc_cancel::UnaryCancelLog>) {
+    if let Some(log) = guard.take() {
+        log.handoff_to_stream();
+    }
+}
+
+fn handoff_unlogged_stream(_: &mut UnloggedStreamingGuard) {}
+
