+/// Compact sender-side copy of message limits. All values remain available for
+/// the public sender's Debug output; only the encoding cap is read on send.
+#[derive(Clone, Copy)]
+pub(crate) struct SenderLimits {
+    encoding: Option<usize>,
+    decoding: usize,
+    compression_frames: usize,
+    #[cfg(feature = "zstd")]
+    zstd_window: u64,
+    present: u8,
+}
+
+impl SenderLimits {
+    #[inline]
+    pub(crate) fn new(limits: MessageLimits) -> Self {
+        let MessageLimits {
+            max_decoding: decoding,
+            max_encoding: encoding,
+            max_compression_frames: compression_frames,
+            #[cfg(feature = "zstd")]
+                max_zstd_window: zstd_window,
+        } = limits;
+        let present = u8::from(decoding.is_some()) | (u8::from(compression_frames.is_some()) << 1);
+        #[cfg(feature = "zstd")]
+        let present = present | (u8::from(zstd_window.is_some()) << 2);
+        Self {
+            encoding,
+            decoding: decoding.unwrap_or_default(),
+            compression_frames: compression_frames.unwrap_or_default(),
+            #[cfg(feature = "zstd")]
+            zstd_window: zstd_window.unwrap_or_default(),
+            present,
+        }
+    }
+
+    #[inline]
+    pub(crate) fn max_encoding(self) -> Option<usize> {
+        self.encoding
+    }
+
+    pub(crate) fn into_message_limits(self) -> MessageLimits {
+        MessageLimits {
+            max_decoding: (self.present & 1 != 0).then_some(self.decoding),
+            max_encoding: self.encoding,
+            max_compression_frames: (self.present & 2 != 0).then_some(self.compression_frames),
+            #[cfg(feature = "zstd")]
+            max_zstd_window: (self.present & 4 != 0).then_some(self.zstd_window),
+        }
+    }
+}
+
 impl Default for MessageLimits {
     /// 4 MiB inbound, unlimited outbound, 1,024 compressed frames per message,
     /// and an 8 MiB Zstd window when enabled.
