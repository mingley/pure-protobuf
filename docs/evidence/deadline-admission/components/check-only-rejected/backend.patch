+/// A request waiting for a real connection-wide stream slot.
+#[derive(Debug)]
+pub struct SendRequestWhenReady<'a, B: Buf> {
+    sender: &'a mut SendRequest<B>,
+    request: Option<Request<()>>,
+    end_of_stream: bool,
+    waiter: Option<std::sync::Arc<atomic_waker::AtomicWaker>>,
+}
+
+impl<B: Buf> Future for SendRequestWhenReady<'_, B> {
+    type Output = Result<(ResponseFuture, SendStream<B>), crate::Error>;
+
+    fn poll(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Self::Output> {
+        let this = self.get_mut();
+        ready!(this.sender.poll_ready(cx))?;
+        let (stream, _is_full) = ready!(this.sender.inner.poll_send_request(
+            &mut this.request,
+            this.end_of_stream,
+            this.sender.pending.as_ref(),
+            cx,
+            &mut this.waiter,
+        ))?;
+        debug_assert!(!stream.is_pending_open());
+        this.waiter = None;
+        Poll::Ready(Ok((
+            ResponseFuture {
+                inner: stream.clone_to_opaque(),
+                push_promise_consumed: false,
+            },
+            SendStream::new(stream),
+        )))
     }
 }
 
