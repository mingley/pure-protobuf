@@ -0,0 +1,161 @@
+//! Borrowed fixed-width encoding and custom-codec fallback checks.
+use super::*;
+
+fn from_values<C: PackedCodec>(values: Vec<C::Elem>) -> Packed<C> {
+    Packed::from_repeated(Repeated::from_vec(values))
+}
+
+#[cfg(target_endian = "little")]
+#[test]
+fn fixed_decoded_values_borrow_storage_without_an_encoded_cache() {
+    fn check<C: PackedCodec>(values: Vec<C::Elem>) {
+        let packed = from_values::<C>(values);
+        let values = packed.as_slice();
+        let borrowed = C::borrow_encoded(values).expect("built-in fixed codec");
+        let expected = {
+            let mut out = Vec::new();
+            C::encode(values, &mut out);
+            out
+        };
+        assert_eq!(packed.packed_bytes(), Some(expected.as_slice()));
+        assert_eq!(
+            packed.packed_bytes().expect("bytes").as_ptr(),
+            borrowed.as_ptr()
+        );
+        assert!(
+            packed
+                .inner
+                .as_ref()
+                .expect("populated")
+                .encoded
+                .get()
+                .is_none(),
+            "borrowing must not populate a duplicate byte cache"
+        );
+    }
+    check::<FixedU32>(vec![0, 1, u32::MAX]);
+    check::<FixedI32>(vec![i32::MIN, -1, i32::MAX]);
+    check::<FixedU64>(vec![0, 1, u64::MAX]);
+    check::<FixedI64>(vec![i64::MIN, -1, i64::MAX]);
+    check::<Ieee32>(vec![f32::from_bits(0x7fc0_0001), -0.0, f32::INFINITY]);
+    check::<Ieee64>(vec![
+        f64::from_bits(0x7ff8_0000_0000_0001),
+        -0.0,
+        f64::INFINITY,
+    ]);
+}
+
+#[test]
+fn fixed_mutation_and_clone_preserve_wire_bytes() {
+    let mut packed = from_values::<FixedU32>(Vec::new());
+    assert_eq!(packed.packed_bytes(), None);
+    assert_eq!(PackedFx32::new().packed_bytes(), None);
+    packed.push(1);
+    packed.push(2);
+    assert_eq!(
+        packed.packed_bytes(),
+        Some([1, 0, 0, 0, 2, 0, 0, 0].as_slice())
+    );
+    let cloned = packed.clone();
+    packed.push(3);
+    assert_eq!(
+        cloned.packed_bytes(),
+        Some([1, 0, 0, 0, 2, 0, 0, 0].as_slice())
+    );
+    assert_eq!(
+        packed.packed_bytes(),
+        Some([1, 0, 0, 0, 2, 0, 0, 0, 3, 0, 0, 0].as_slice())
+    );
+    packed.append_bytes(&4_u32.to_le_bytes()).expect("append");
+    assert_eq!(packed.iter().copied().collect::<Vec<_>>(), [1, 2, 3, 4]);
+    packed.as_mut().set(0, 9);
+    assert_eq!(
+        packed.packed_bytes().expect("bytes").get(..4),
+        Some(9_u32.to_le_bytes().as_slice())
+    );
+    packed.clear();
+    assert_eq!(packed.packed_bytes(), None);
+    packed.push(u32::MAX);
+    assert_eq!(
+        packed.packed_bytes(),
+        Some(u32::MAX.to_le_bytes().as_slice())
+    );
+    packed.clear();
+    packed.append_bytes(&7_u32.to_le_bytes()).expect("regrow");
+    assert_eq!(packed.packed_bytes(), Some(7_u32.to_le_bytes().as_slice()));
+}
+
+#[test]
+fn varints_still_use_canonical_encoded_cache() {
+    let mut packed = PackedU32::new();
+    packed
+        .append_wire(Wire::from_slice(&[0x81, 0x00]))
+        .expect("overlong accepted");
+    assert_eq!(packed.packed_bytes(), Some([1].as_slice()));
+    assert!(
+        packed
+            .inner
+            .as_ref()
+            .expect("populated")
+            .encoded
+            .get()
+            .is_some()
+    );
+    packed.push(128);
+    assert_eq!(packed.packed_bytes(), Some([1, 0x80, 1].as_slice()));
+}
+
+#[derive(Clone, Copy, Default, Debug, PartialEq)]
+#[repr(C)]
+struct Padded {
+    small: u8,
+    wide: u32,
+}
+
+enum CustomFlag {}
+impl PackedCodec for CustomFlag {
+    type Elem = Padded;
+    const MEMCPY_SAFE: bool = true;
+
+    fn validate(buf: &[u8]) -> Result<(), ParseError> {
+        if buf.len() % 5 == 0 {
+            Ok(())
+        } else {
+            Err(ParseError::new("custom width"))
+        }
+    }
+
+    fn decode(buf: &[u8], out: &mut Vec<Padded>) -> Result<(), ParseError> {
+        Self::validate(buf)?;
+        for bytes in buf.chunks_exact(5) {
+            out.push(Padded {
+                small: bytes[0],
+                wide: u32::from_le_bytes(bytes[1..].try_into().expect("checked width")),
+            });
+        }
+        Ok(())
+    }
+
+    fn encode(elems: &[Padded], out: &mut Vec<u8>) {
+        for value in elems {
+            out.push(value.small);
+            out.extend_from_slice(&value.wide.to_le_bytes());
+        }
+    }
+}
+
+#[test]
+fn public_memcpy_flag_does_not_authorize_generic_memory_reinterpretation() {
+    let packed = from_values::<CustomFlag>(vec![Padded { small: 1, wide: 2 }]);
+    assert_eq!(CustomFlag::borrow_encoded(packed.as_slice()), None);
+    assert_eq!(packed.packed_bytes(), Some([1, 2, 0, 0, 0].as_slice()));
+    assert!(
+        packed
+            .inner
+            .as_ref()
+            .expect("populated")
+            .encoded
+            .get()
+            .is_some()
+    );
+}
