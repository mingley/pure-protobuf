+#[cfg(test)]
+mod singleton_storage_tests {
+    use super::Repeated;
+    use std::sync::{
+        Arc,
+        atomic::{AtomicUsize, Ordering},
+    };
+
+    #[test]
+    fn singleton_proxy_mutation_and_owned_vec() {
+        let mut values: Repeated<i32> = [7].into_iter().collect();
+        assert_eq!(values.as_slice(), &[7]);
+        assert_eq!(values.as_view().len(), 1);
+        assert_eq!(values.get(0), Some(&7));
+        *values.get_mut(0).unwrap() = 8;
+        values.as_mut_slice()[0] = 9;
+        {
+            let mut proxy = values.as_mut();
+            assert_eq!(proxy.len(), 1);
+            proxy.push(10);
+            proxy.set(0, 11);
+        }
+        assert_eq!(values.as_slice(), &[11, 10]);
+        assert_eq!(values.into_vec(), vec![11, 10]);
+
+        let mut first = Repeated::new();
+        first.push(1);
+        first.push(2);
+        first.reserve(7);
+        assert_eq!(first.as_slice(), &[1, 2]);
+        first.clear();
+        assert!(first.is_empty());
+    }
+
+    #[test]
+    fn non_clone_elements_drop_once_through_transitions() {
+        struct Value(Arc<AtomicUsize>);
+        impl Drop for Value {
+            fn drop(&mut self) {
+                self.0.fetch_add(1, Ordering::SeqCst);
+            }
+        }
+        let count = Arc::new(AtomicUsize::new(0));
+        let mut values: Repeated<Value> = [Value(count.clone())].into_iter().collect();
+        assert_eq!(values.len(), 1);
+        assert_eq!(values.as_mut().len(), 1);
+        values.push(Value(count.clone()));
+        let owned = values.into_vec();
+        assert_eq!(count.load(Ordering::SeqCst), 0);
+        drop(owned);
+        assert_eq!(count.load(Ordering::SeqCst), 2);
+
+        let values: Repeated<Value> = [Value(count.clone())].into_iter().collect();
+        drop(values.into_vec());
+        assert_eq!(count.load(Ordering::SeqCst), 3);
+    }
+
+    #[test]
+    fn aligned_and_zero_sized_values_keep_layout_and_drops() {
+        #[repr(align(128))]
+        struct Aligned(u8);
+        let mut values: Repeated<Aligned> = [Aligned(3)].into_iter().collect();
+        assert_eq!((values.as_slice().as_ptr() as usize) % 128, 0);
+        assert_eq!(values.as_mut_slice()[0].0, 3);
+        values.push(Aligned(4));
+        assert_eq!((values.as_slice().as_ptr() as usize) % 128, 0);
+        assert_eq!(
+            values.into_vec().iter().map(|v| v.0).collect::<Vec<_>>(),
+            [3, 4]
+        );
+        assert_eq!(
+            core::mem::size_of::<Repeated<Aligned>>(),
+            core::mem::size_of::<usize>()
+        );
+
+        static DROPPED: AtomicUsize = AtomicUsize::new(0);
+        struct Zst;
+        impl Drop for Zst {
+            fn drop(&mut self) {
+                DROPPED.fetch_add(1, Ordering::SeqCst);
+            }
+        }
+        DROPPED.store(0, Ordering::SeqCst);
+        let mut zst: Repeated<Zst> = [Zst].into_iter().collect();
+        zst.push(Zst);
+        drop(zst.into_vec());
+        assert_eq!(DROPPED.load(Ordering::SeqCst), 2);
+    }
+
+    #[test]
+    fn lying_size_hint_still_collects_every_element() {
+        struct Liar(core::ops::Range<i32>);
+        impl Iterator for Liar {
+            type Item = i32;
+            fn next(&mut self) -> Option<Self::Item> {
+                self.0.next()
+            }
+            fn size_hint(&self) -> (usize, Option<usize>) {
+                (0, Some(1))
+            }
+        }
+        let values: Repeated<i32> = Liar(0..3).collect();
+        assert_eq!(values.as_slice(), &[0, 1, 2]);
+    }
+
+    #[test]
+    fn panicking_iterator_drops_the_yielded_value_once() {
+        struct Value(Arc<AtomicUsize>);
+        impl Drop for Value {
+            fn drop(&mut self) {
+                self.0.fetch_add(1, Ordering::SeqCst);
+            }
+        }
+        struct Panics(Option<Value>);
+        impl Iterator for Panics {
+            type Item = Value;
+            fn next(&mut self) -> Option<Value> {
+                if let Some(value) = self.0.take() {
+                    Some(value)
+                } else {
+                    panic!("iterator test panic")
+                }
+            }
+            fn size_hint(&self) -> (usize, Option<usize>) {
+                (0, Some(1))
+            }
+        }
+        let count = Arc::new(AtomicUsize::new(0));
+        let caught = std::panic::catch_unwind(|| {
+            let _: Repeated<Value> = Panics(Some(Value(count.clone()))).collect();
+        });
+        assert!(caught.is_err());
+        assert_eq!(count.load(Ordering::SeqCst), 1);
+    }
+}
